LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Optional: keep the current LiveKit Inference models unless intentionally changing them.
ADVOCATE_LLM_MODEL=google/gemma-4-31b-it
ADVOCATE_STT_MODEL=assemblyai/universal-3-6-pro
ADVOCATE_TTS_MODEL=fishaudio/s2.1-pro
ADVOCATE_TTS_VOICE=fa4c9eb3dccc4806b382b40d61c6b10a

# Optional Anam avatar. Keep these server-side in agent/.env.local.
ANAM_API_KEY=
ANAM_AVATAR_ID=
ANAM_ENABLED=true
ANAM_AVATAR_NAME=AI Advocate
ANAM_AVATAR_MODEL=cara-4.1-express
