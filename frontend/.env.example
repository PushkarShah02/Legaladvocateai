# Server-side only. Configure Production and, if needed, Preview in Vercel.
# Use the SAME LiveKit Cloud project as the deployed Python agent.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Must match the Python rtc_session name, NOT its CA_ deployment ID.
AGENT_NAME=my-agent

# No NEXT_PUBLIC_ secrets, Anam keys, model keys, development token server,
# or IS_VERCEL_PREVIEW bypass are needed. Anam runs in the Cloud Python agent.
